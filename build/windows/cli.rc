IDI_ICON1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Profipoint"
            VALUE "FileDescription",  "ChapterSmith - CLI"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "chaptersmith"
            VALUE "OriginalFilename", "chaptersmith.exe"
            VALUE "ProductName",      "ChapterSmith"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
